# ==========================================
# MongoDB & Authentication
# ==========================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/realtime-connect?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# App & Socket URLs
# ==========================================
NEXT_PUBLIC_APP_URL=https://real-time-connect.vercel.app
ALLOWED_ORIGIN=https://real-time-connect.vercel.app
# Leave empty for Next.js internal /api/socket, or provide external Render URL (e.g. https://socket-server-yqf1.onrender.com)
NEXT_PUBLIC_SOCKET_URL=

# ==========================================
# Cloudinary (Media Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Firebase Client SDK (Web Push / FCM)
# (Get from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# (Get from Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates -> Key pair)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key

# ==========================================
# Firebase Admin SDK (Server-Side Push Sending)
# (Get from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
# ==========================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
